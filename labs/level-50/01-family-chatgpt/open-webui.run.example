# Open WebUI 的启动命令，家里人进的那个门。
#
# 这个文件不会被执行，是给你照抄的。每条命令上面写了它干什么。
# 教材第 6 卷第 4 章、第 5 章。

# ---------------------------------------------------------------- 1
# 先建一个放数据的目录。对话记录、账号、上传的文件都存在这儿。
# 这个目录删了，全家人的聊天记录就没了，它要进备份（教材第 2 卷第 12 章）。

mkdir -p "$HOME/ai/projects/open-webui/data"

# ---------------------------------------------------------------- 2
# 看一眼端口空着没有。没有任何输出就是空着的。
# 3080 是本教材挑的，3000 被 Gitea 占了、3001 被监控面板占了。

ss -tln | grep :3080

# ---------------------------------------------------------------- 3
# 起容器。整段是一条命令，行尾的反斜杠不能少。
#
#   --restart unless-stopped  机器重启之后它自己回来，这一项是这个实验的验收点之一
#   -p 3080:8080              宿主机的 3080 通到容器里的 8080
#   --add-host 加 -e          这一对合起来让容器找得到宿主机上的 Ollama
#   -v                        数据存在宿主机上，容器删了数据还在

docker run -d \
  --name open-webui \
  --restart unless-stopped \
  -p 3080:8080 \
  --add-host=host.docker.internal:host-gateway \
  -e OLLAMA_BASE_URL=http://host.docker.internal:11434 \
  -v "$HOME/ai/projects/open-webui/data:/app/backend/data" \
  ghcr.io/open-webui/open-webui:main

# ---------------------------------------------------------------- 4
# 看它起来没有。STATUS 那列是 Up 加上跑了多久就对了。
# 第一次启动要初始化，可能要等一两分钟。

docker ps

# ---------------------------------------------------------------- 5
# 起不来就看日志，别瞎猜。

docker logs open-webui --tail 50

# ---------------------------------------------------------------- 6
# 收紧一点的写法（可选）。
#
# 上面那条 -p 3080:8080 会把这个口开在这台机器的所有地址上。
# 只想开给局域网和 Tailscale 两个地址的话，先停掉再删掉容器，
# 用下面这一版重起。数据在宿主机目录里，删容器不会丢。
#
#   docker stop open-webui && docker rm open-webui
#
# 然后把上面第 3 步里的 -p 那一行换成这两行（地址换成你自己的）：
#
#   -p 192.168.1.50:3080:8080 \
#   -p 100.101.102.103:3080:8080 \
#
# 换完之后 http://localhost:3080 会打不开，这是对的。
# 在机器本地也要用 http://192.168.1.50:3080。
